# 复制为 .env 后按需修改；所有项都有默认值，不配也能跑。

# SQLite 主库路径（默认：项目根 WorkHub.db）
# 想直接读 C# 版的老库，改成 E:\01_python_project\28_WorkHub\01_WorkHub_C\WorkHub.db
WORKHUB_DB_PATH=

# 监听地址与端口（默认只听回环）
WORKHUB_HOST=127.0.0.1
WORKHUB_PORT=5277

# 会话 Cookie
WORKHUB_COOKIE_NAME=workhub_session
WORKHUB_COOKIE_MAX_AGE=43200
# 留空则首次启动自动生成并存进 SysConfig[workhub.session.key]
WORKHUB_SESSION_KEY=
# 走 HTTPS / TLS 反代时置 1
WORKHUB_COOKIE_SECURE=0

# 安全边界：绑到非回环地址且是明文 HTTP 时，除非下面任一项为真，否则拒绝启动
WORKHUB_ALLOW_INSECURE_REMOTE=0
WORKHUB_BEHIND_TLS_PROXY=0
# 访问白名单：IP 或 IPv4 CIDR，逗号/分号分隔；留空不限制
WORKHUB_ALLOWED_NETWORKS=
